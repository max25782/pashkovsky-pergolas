{
  "mcpServers": {
    "bedrock-agent": {
      "command": "bash",
      "args": [
        "mcp-servers/start.sh"
      ],
      "env": {
        "AWS_REGION": "${AWS_REGION}",
        "AWS_ACCESS_KEY_ID": "${AWS_ACCESS_KEY_ID}",
        "AWS_SECRET_ACCESS_KEY": "${AWS_SECRET_ACCESS_KEY}",
        "BEDROCK_AGENT_ID": "${BEDROCK_AGENT_ID}",
        "BEDROCK_AGENT_ALIAS_ID": "${BEDROCK_AGENT_ALIAS_ID}"
      }
    }
  }
}
