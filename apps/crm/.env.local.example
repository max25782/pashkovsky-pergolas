# =============================================================================
# ENVIRONMENT VARIABLES — local development
# Copy this file to .env.local and fill in real values.
# .env.local is in .gitignore; never commit real secrets.
# =============================================================================

# --- Production Supabase (read-only for dumps, not used by the dev server) ---
# SUPABASE_URL=https://kvqupacmdishpfnscnio.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=<prod service role JWT>
# SUPABASE_ANON_KEY=<prod anon JWT>
# NEXT_PUBLIC_SUPABASE_URL=https://kvqupacmdishpfnscnio.supabase.co
# NEXT_PUBLIC_SUPABASE_ANON_KEY=<prod anon JWT>

# --- Local Supabase (supabase start) -----------------------------------------
# Run `supabase status` after `supabase start` to get these values.
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_SERVICE_ROLE_KEY=<from supabase status: service_role key>
SUPABASE_ANON_KEY=<from supabase status: anon key>

NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=<from supabase status: anon key>

# Direct postgres connection (for psql / pg_dump restore)
# DB_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres

# --- Other services (keep same values as .env for local dev) -----------------
ADMIN_TOKEN=Hr11062015ks

# AI (Gemini)
GEMINI_API_KEY=<your key>

# AWS S3
AWS_S3_BUCKET_NAME=pashkovsky-gallery
AWS_S3_REGION=eu-north-1
AWS_ACCESS_KEY_ID=<your key>
AWS_SECRET_ACCESS_KEY=<your secret>
NEXT_PUBLIC_AWS_S3_BUCKET_NAME=pashkovsky-gallery
NEXT_PUBLIC_AWS_S3_REGION=eu-north-1

# Email (Zoho) — use Mailtrap or similar locally
EMAIL_HOST=smtp.example.com
EMAIL_PORT=465
EMAIL_USER=dev@example.com
EMAIL_PASS=dev
EMAIL_FROM="CRM Dev <dev@example.com>"

# JWT
JWT_SECRET=dev-jwt-secret-change-me
