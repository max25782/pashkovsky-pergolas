{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "version": 2,
  "buildCommand": "cd ../.. && npm install --include=dev && npx turbo run build --filter=@alumincrm/app",
  "outputDirectory": ".next",
  "installCommand": "cd ../.. && npm install --include=dev",
  "framework": "nextjs",
  "crons": [
    {
      "path": "/api/cron/weekly-owner-report",
      "schedule": "0 * * * *"
    }
  ]
}
