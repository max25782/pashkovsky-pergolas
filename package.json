{
  "name": "pashkovsky-monorepo",
  "private": true,
  "version": "0.1.0",
  "packageManager": "npm@10.2.4",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npx turbo run dev",
    "dev:all": "./start-all.sh",
    "dev:profiles": "npx turbo run dev --filter=@pashkovsky/profiles-api --filter=@pashkovsky/profiles-store",
    "dev:site": "npx turbo run dev --filter=@pashkovsky/site",
    "dev:crm": "npx turbo run dev --filter=@pashkovsky/crm",
    "dev:landing": "npx turbo run dev --filter=@pashkovsky/landing",
    "stop:all": "./stop-all.sh",
    "build": "npx turbo run build",
    "build:site": "npx turbo run build --filter=@pashkovsky/site",
    "build:crm": "npx turbo run build --filter=@pashkovsky/crm",
    "build:landing": "npx turbo run build --filter=@pashkovsky/landing",
    "start": "npx turbo run start",
    "lint": "npx turbo run lint",
    "clean": "npx turbo run clean && rm -rf node_modules",
    "gen:gallery": "node scripts/generate-gallery.mjs",
    "gen:pergulot": "node scripts/generate-pergulot-i18n.mjs",
    "video:posters": "node scripts/generate-video-posters.mjs"
  },
  "devDependencies": {
    "turbo": "^2.7.1",
    "typescript": "^5.6.2"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.89.0",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.45",
    "tailwindcss": "^3.4.10"
  }
}
