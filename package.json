{
  "name": "pashkovsky-monorepo",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo run dev",
    "dev:site": "turbo run dev --filter=@pashkovsky/site",
    "dev:crm": "turbo run dev --filter=@pashkovsky/crm",
    "build": "turbo run build",
    "build:site": "turbo run build --filter=@pashkovsky/site",
    "build:crm": "turbo run build --filter=@pashkovsky/crm",
    "start": "turbo run start",
    "lint": "turbo run lint",
    "clean": "turbo run clean && rm -rf node_modules",
    "gen:gallery": "node scripts/generate-gallery.mjs",
    "gen:pergulot": "node scripts/generate-pergulot-i18n.mjs",
    "video:posters": "node scripts/generate-video-posters.mjs"
  },
  "devDependencies": {
    "turbo": "^2.7.1",
    "typescript": "^5.6.2"
  }
}
