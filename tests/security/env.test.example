# Test Environment Variables
# Copy this to tests/security/.env.test and fill in the values

# API Base URL
TEST_API_URL=http://localhost:3000

# Test User A (Company A)
TEST_USER_A_EMAIL=userA@companyA.com
TEST_USER_A_PASSWORD=testpass123
TEST_COMPANY_A_ID=00000000-0000-0000-0000-000000000001

# Test User B (Company B)
TEST_USER_B_EMAIL=userB@companyB.com
TEST_USER_B_PASSWORD=testpass123
TEST_COMPANY_B_ID=00000000-0000-0000-0000-000000000002

# Test Data IDs (seed these in your test database)
TEST_COMPANY_B_LEAD_ID=lead-b-uuid-here
TEST_COMPANY_B_DEAL_ID=deal-b-uuid-here
TEST_COMPANY_B_OFFER_ID=offer-b-uuid-here
TEST_COMPANY_B_WORKER_ID=worker-b-uuid-here

